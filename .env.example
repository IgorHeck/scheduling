# ============================================================
# Template de variáveis do monorepo scheduling.
# Copie para .env e preencha os valores reais:
#   cp .env.example .env
# ============================================================

# === Banco de dados (Postgres) ===
DB_HOST=postgres
DB_PORT=5432
DB_NAME=scheduling_db
DB_USER=postgres
DB_PASS=sua_senha_aqui

# === Redis ===
REDIS_HOST=redis
REDIS_PORT=6379

# === JWT — gere uma chave base64 forte (ex.: openssl rand -base64 48) ===
JWT_SECRET=gere_uma_chave_base64_forte_aqui

# === Email (dev usa mailhog, prod usa SMTP real) ===
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USER=
MAIL_PASS=

# === Frontend (Vite) ===
VITE_API_URL=http://localhost:8080
